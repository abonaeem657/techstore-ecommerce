@model Product
@{ ViewData["Title"] = "Edit product"; }
<section class="card form-panel p-4 p-md-5">
<p class="eyebrow">Product management</p><h1 class="h3 mb-4">Edit product</h1>
<form asp-action="edit" method="post">
<input asp-for="Id" type="hidden" />
<partial name="_ProductFields" model="Model" />
<div class="d-flex flex-wrap gap-2"><button type="submit" class="btn btn-primary">Save changes</button><a asp-action="Viewdata" class="btn btn-outline-secondary">Cancel</a></div>
</form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

