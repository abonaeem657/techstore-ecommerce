@model List<Product>
@{
    ViewData["Title"] = "Products";
    var categories = ViewData["Categories"] as List<string> ?? new List<string>();
    var filtered = !string.IsNullOrWhiteSpace(ViewData["Search"] as string) || !string.IsNullOrWhiteSpace(ViewData["Category"] as string);
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div><p class="eyebrow mb-2">The collection</p><h1>Explore products</h1><p class="text-muted mb-0">@Model.Count of @ViewData["TotalCount"] product(s)</p></div>
    <a asp-action="additem" class="btn btn-primary">+ Add product</a>
</div>
<form asp-action="Viewdata" method="get" class="card p-3 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-5"><label for="search" class="form-label">Search products</label><input id="search" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by name" type="search" /></div>
        <div class="col-md-3"><label for="category" class="form-label">Category</label><select id="category" name="category" class="form-select"><option value="">All categories</option>
        @foreach (var category in categories)
        {
            <option value="@category" selected="@(category == ViewData["Category"] as string)">@category</option>
        }
        </select></div>
        <div class="col-md-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Search</button><a asp-action="Viewdata" class="btn btn-outline-secondary">Clear</a></div>
    </div>
</form>
@if (Model.Count == 0 && filtered)
{
    <div class="card empty-state"><h2 class="h4">No matching products</h2><p class="text-muted">Try a different name or category.</p><div><a asp-action="Viewdata" class="btn btn-outline-primary">Clear filters</a></div></div>
}
else if (Model.Count == 0)
{
    <div class="card empty-state"><h2 class="h4">No products available</h2><p class="text-muted">Add your first product to start building the collection.</p><div><a asp-action="additem" class="btn btn-primary">Add a product</a></div></div>
}
else
{
    <div class="row g-4">
    @foreach (var product in Model)
    {
        <div class="col-sm-6 col-lg-4">
            <article class="card h-100">
                <partial name="_ProductVisual" />
                <div class="card-body d-flex flex-column p-4">
                    <span class="text-muted small mb-2">@product.Type</span>
                    <h2 class="h5 product-name">@product.Name</h2>
                    <p class="price">@product.Price.ToString("N2")</p>
                    <div class="d-flex flex-wrap gap-2 mt-auto">
                        <a asp-action="one" asp-route-id="@product.Id" class="btn btn-primary btn-sm" aria-label="Details for @product.Name">Details</a>
                        <a asp-action="edit" asp-route-id="@product.Id" class="btn btn-outline-secondary btn-sm" aria-label="Edit @product.Name">Edit</a>
                        <a asp-action="delete" asp-route-id="@product.Id" class="btn btn-outline-danger btn-sm" aria-label="Delete @product.Name">Delete</a>
                    </div>
                </div>
            </article>
        </div>
    }
    </div>
}

