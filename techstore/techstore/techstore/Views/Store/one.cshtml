@model Product
@{ ViewData["Title"] = Model.Name; }
<a asp-action="Viewdata" class="d-inline-block mb-4">&larr; Back to products</a>
<article class="card">
    <div class="row g-0">
        <div class="col-md-5 product-visual"><partial name="_ProductVisual" /></div>
        <div class="col-md-7 p-4 p-md-5"><p class="eyebrow">@Model.Type</p><h1 class="product-name">@Model.Name</h1><p class="text-muted">Product #@Model.Id</p><p class="price mb-4">@Model.Price.ToString("N2")</p>
            <div class="d-flex flex-wrap gap-2"><a asp-action="edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit product</a><a asp-action="delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete product</a></div>
        </div>
    </div>
</article>

