@model Product
@{ ViewData["Title"] = "Delete product"; }
<section class="card form-panel p-4 p-md-5">
    <p class="eyebrow">Product management</p><h1 class="h3">Delete product?</h1>
    <p class="text-muted">This will remove the product from the collection. This action cannot be undone.</p>
    <div class="border rounded p-3 my-3"><h2 class="h5 product-name">@Model.Name</h2><p class="text-muted mb-1">@Model.Type</p><strong>@Model.Price.ToString("N2")</strong></div>
    <form asp-action="delete" asp-controller="Store" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="d-flex flex-wrap gap-2"><button class="btn btn-danger" type="submit">Delete product</button><a asp-action="Viewdata" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</section>

