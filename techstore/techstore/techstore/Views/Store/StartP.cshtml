@{ ViewData["Title"] = "Home"; }
<section class="hero">
    <p class="eyebrow">Welcome to TechStore</p>
    <h1 class="display-4 mb-3">Your next setup<br />starts here.</h1>
    <p class="lead text-muted mb-4">Explore our technology collection, compare products, and find the right fit for your everyday work.</p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-action="Viewdata">Explore products &rarr;</a>
        <a class="btn btn-outline-primary" asp-action="SignUp">Create an account</a>
    </div>
</section>
<section class="row g-4 mt-3" aria-label="About the store">
    <div class="col-md-4"><h2 class="h5">A clear overview</h2><p class="text-muted">Browse product names, categories, and prices in one place.</p></div>
    <div class="col-md-4"><h2 class="h5">Simple product management</h2><p class="text-muted">Add new products and keep the collection up to date.</p></div>
    <div class="col-md-4"><h2 class="h5">Built for learning</h2><p class="text-muted">A small ASP.NET Core MVC portfolio project focused on the fundamentals.</p></div>
</section>

