@{ ViewData["Title"] = "Privacy & demo information"; }
<section class="card p-4 p-md-5"><h1 class="h3">Privacy &amp; demo information</h1>
<p>TechStore is a student portfolio demonstration. It does not process payments or orders.</p>
<p>Products are stored temporarily and reset when the application restarts. Demo accounts are saved locally on the server.</p>
<p>Passwords are stored as salted hashes using ASP.NET Core's password hasher. Login uses a protected authentication cookie; logging out removes it. Please use fictional details for this portfolio demonstration.</p>
<a asp-controller="Store" asp-action="Viewdata">Back to products</a></section>
