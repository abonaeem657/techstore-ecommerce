@model Product
@{
    var photoClass = Model.Type.Trim().ToLowerInvariant() switch
    {
        "laptop" or "laptops" => "product-photo--laptop",
        "audio" or "headphones" => "product-photo--audio",
        "accessories" or "keyboard" or "keyboards" => "product-photo--keyboard",
        _ => ""
    };
}
<div class="product-visual @(photoClass.Length > 0 ? "product-photo " + photoClass : "")"
     role="img" aria-label="@(photoClass.Length > 0 ? "Illustrative " + Model.Type + " product photo" : "Product image unavailable")">
    @if (photoClass.Length == 0)
    {
        <svg viewBox="0 0 80 64" fill="none" aria-hidden="true"><rect x="12" y="8" width="56" height="38" rx="4" stroke="currentColor" stroke-width="3"/><path d="M5 51h70l-5 5H10z" stroke="currentColor" stroke-width="3"/><path d="m32 24-6 5 6 5m16-10 6 5-6 5" stroke="currentColor" stroke-width="2"/></svg>
    }
</div>
