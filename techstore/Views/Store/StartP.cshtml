@{ ViewData["Title"] = "Home"; }
<section class="storefront-hero" aria-labelledby="hero-title">
    <div class="storefront-copy">
        <p class="eyebrow">Thoughtful tech for every day</p>
        <h1 id="hero-title">Upgrade the way<br /><em>you work and play.</em></h1>
        <p>Explore a focused collection of technology essentials, find what fits your routine, and keep everything organized in one place.</p>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-primary" asp-action="Viewdata">Browse the collection <span aria-hidden="true">↗</span></a>
            <a class="btn btn-outline-light" asp-action="SignUp">Create an account</a>
        </div>
    </div>
    <div class="device-stage" aria-hidden="true"><div class="device-screen"><span>TECH<br />STORE</span><small>EVERYDAY, UPGRADED</small></div><div class="device-base"></div></div>
</section>
<section class="storefront-intro" aria-labelledby="intro-title"><p class="eyebrow">A simpler way to explore</p><h2 id="intro-title">Everything you need to get started.</h2></section>
<section class="storefront-features" aria-label="Store features">
    <article><span>01 / DISCOVER</span><h3>Browse with ease</h3><p>See products, categories, and prices in a clear catalog.</p></article>
    <article><span>02 / FIND YOUR FIT</span><h3>Search and filter</h3><p>Narrow the collection by product name or category.</p></article>
    <article><span>03 / STAY CURRENT</span><h3>Manage products</h3><p>Use your account to add, edit, and remove catalog items.</p></article>
</section>
